# 联网搜索：默认 Tavily，也可切回 SerpAPI
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Legacy SerpAPI (optional)
# SERPAPI_KEY=Your SERPAPI_KEY

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-v4.1-flash

# 智谱 GLM OpenAI-compatible API
GLM_API_KEY=
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL_NAME=glm-5.3-flash

# 模型名称配置（可选，不设置则使用默认值）
# 本地 Ollama 模型名称
# OLLAMA_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# Ollama 生成保护（可选，默认值如下）
# OLLAMA_MAX_OUTPUT_TOKENS=1024
# OLLAMA_QUERY_MAX_TOKENS=64
# OLLAMA_TIMEOUT_SECONDS=300
# SiliconFlow 云端模型名称
# SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# Magick API 模型名称
# MAGICK_MODEL_NAME=gpt-4o-mini

# 持久化数据目录（可选，默认 data/）
# RAG_DATA_DIR=data

# 向量化模型（可选，默认 all-MiniLM-L6-v2；中文语料建议换 BGE 中文模型）
# EMBED_MODEL_NAME=BAAI/bge-base-zh-v1.5
# BGE 中文模型建议只给查询加指令前缀，文档向量不加
# EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# 重排序模型（可选，默认 BAAI/bge-reranker-base，支持中英文）
# RERANK_MODEL_NAME=BAAI/bge-reranker-base
# 重排序方式：cross_encoder 或 llm（默认 cross_encoder）
# RERANK_METHOD=cross_encoder
